<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RootNamespace>OfficeAgent.Samples.ExcelRecalculation</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OfficeAgent.Abstractions\OfficeAgent.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\OfficeAgent.Core\OfficeAgent.Core.csproj" />
    <ProjectReference Include="..\..\src\OfficeAgent.Excel\OfficeAgent.Excel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- OpenXML SDK for direct SpreadsheetDocument manipulation -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />

    <!-- For comparison: ClosedXML for formula evaluation -->
    <PackageReference Include="ClosedXML" Version="0.105.1" />
  </ItemGroup>

</Project>
