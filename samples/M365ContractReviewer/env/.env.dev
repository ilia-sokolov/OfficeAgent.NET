# Settings for the "dev" environment. Fill in the first two before provisioning.
# Provisioning writes the generated values below them. Keep your filled-in copy out of
# version control: it names your server and your tenant's registrations.

# Your hosted OfficeAgent MCP endpoint, for example https://<your-server>/ (HTTPS, ends in /).
OFFICEAGENT_MCP_URL=
# Application (client) ID of the middle-tier API app registration the server uses for
# On-Behalf-Of (the server's SharePointConnections__0__ClientId).
OFFICEAGENT_API_CLIENT_ID=

# Built-in environment variables
TEAMSFX_ENV=dev
APP_NAME_SUFFIX=dev
AGENT_SCOPE=shared

# Generated during provision
TEAMS_APP_ID=
MCP_DA_AUTH_ID_OFFICEAGENT=
OFFICEAGENT_SSO_APPLICATION_ID_URI=
M365_TITLE_ID=
M365_APP_ID=
SHARE_LINK=
