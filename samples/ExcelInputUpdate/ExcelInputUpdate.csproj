<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RootNamespace>OfficeAgent.Samples.ExcelInputUpdate</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\OfficeAgent.Abstractions\OfficeAgent.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\OfficeAgent.Core\OfficeAgent.Core.csproj" />
    <ProjectReference Include="..\..\src\OfficeAgent.Excel\OfficeAgent.Excel.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Optional step 3 only: OfficeAgent has no formula engine. ClosedXML evaluates the saved
         workbook in memory; it never writes the file. -->
    <PackageReference Include="ClosedXML" Version="0.105.1" />
  </ItemGroup>
</Project>
