<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- The engine seams are [Experimental] with OFFICEAGENT001 (docs/compatibility.md). The
       engine, its tests and tools are built from them, so they suppress it. Samples do not:
       a sample is host code, and a host that needs a seam has left the stable 1.x surface. -->
  <PropertyGroup>
    <OfficeAgentProjectPath>$([MSBuild]::MakeRelative('$(MSBuildThisFileDirectory)', '$(MSBuildProjectDirectory)'))</OfficeAgentProjectPath>
  </PropertyGroup>

  <PropertyGroup Condition="!$(OfficeAgentProjectPath.StartsWith('samples'))">
    <NoWarn>$(NoWarn);OFFICEAGENT001</NoWarn>
  </PropertyGroup>

  <!-- Projects in OfficeAgent.NET.sln restore from a committed packages.lock.json, so CI builds
       exactly what was reviewed. Skills and the plugin hand their projects to consumers, and
       deploy and RequirementsReview are outside the solution, so they stay out. -->
  <PropertyGroup Condition="!$(OfficeAgentProjectPath.StartsWith('skills'))
                            And !$(OfficeAgentProjectPath.StartsWith('plugins'))
                            And !$(OfficeAgentProjectPath.StartsWith('deploy'))
                            And !$(MSBuildProjectName.StartsWith('RequirementsReview'))">
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- A runtime-specific publish would rewrite the committed files, so it writes elsewhere. -->
    <NuGetLockFilePath Condition="'$(OfficeAgentLockFileRoot)' != ''">$(OfficeAgentLockFileRoot)/$(MSBuildProjectName).lock.json</NuGetLockFilePath>
  </PropertyGroup>

  <PropertyGroup>
    <Version>1.2.0</Version>
    <Authors>Ilia Sokolov</Authors>
    <Company>Ilia Sokolov</Company>
    <Product>OfficeAgent.NET</Product>
    <Copyright>Copyright (c) 2026 Ilia Sokolov</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ilia-sokolov/OfficeAgent.NET</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ilia-sokolov/OfficeAgent.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>openxml;docx;pptx;xlsx;word;powerpoint;excel;office;mcp;model-context-protocol;ai;agents;llm;tracked-changes;document-automation</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <Deterministic>true</Deterministic>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false' AND Exists('$(MSBuildThisFileDirectory)README.md')">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false' AND Exists('$(MSBuildThisFileDirectory)icon.png')">
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
  <!-- Source Link is built into the .NET 8+ SDK. The standalone
       Microsoft.SourceLink.GitHub 8.0.0 package pulls Microsoft.Build.Tasks.Git
       8.0.0, which carries GHSA-23fw-v26w-5fgq with no patched 8.x release. -->
</Project>
