<?xml version="1.0" encoding="UTF-8"?>
<!--
  OfficeAgent renderer hardening, installed into LibreOffice's share/registry so it applies to
  every user profile. Every value is finalized, so a profile cannot override it.

  Values were checked against LibreOffice's own schema (officecfg/registry/schema) rather than
  third-party guidance. Writer and Calc number "never" differently: Writer Content/Update/Link
  is 0 always, 1 on request, 2 never; Calc Content/Update/Link is 0 always, 1 never, 2 on
  request. One widely cited hardening guide gives Writer 0, which is "always".
-->
<oor:data xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:oor="http://openoffice.org/2001/registry">
  <dependency file="main"/>
  <oor:component-data oor:name="Common" oor:package="org.openoffice.Office">
    <node oor:name="Security">
      <node oor:name="Scripting">
        <!-- 3 = Very High: only macros from trusted locations run; there are none. -->
        <prop oor:name="MacroSecurityLevel" oor:finalized="true" oor:type="xs:int"><value>3</value></prop>
        <prop oor:name="DisableMacrosExecution" oor:finalized="true" oor:type="xs:boolean"><value>true</value></prop>
        <prop oor:name="SecureURL" oor:finalized="true" oor:type="oor:string-list"><value/></prop>
        <!-- Do not fetch images or other content from locations the document names. -->
        <prop oor:name="BlockUntrustedRefererLinks" oor:finalized="true" oor:type="xs:boolean"><value>true</value></prop>
      </node>
    </node>
  </oor:component-data>
  <oor:component-data oor:name="Writer" oor:package="org.openoffice.Office">
    <node oor:name="Content">
      <node oor:name="Update">
        <!-- Writer: 2 = never update links when loading. -->
        <prop oor:name="Link" oor:finalized="true" oor:type="xs:int"><value>2</value></prop>
      </node>
    </node>
  </oor:component-data>
  <oor:component-data oor:name="Calc" oor:package="org.openoffice.Office">
    <node oor:name="Content">
      <node oor:name="Update">
        <!-- Calc: 1 = never update links when loading. -->
        <prop oor:name="Link" oor:finalized="true" oor:type="xs:int"><value>1</value></prop>
      </node>
    </node>
  </oor:component-data>
  <oor:component-data oor:name="ExtensionManager" oor:package="org.openoffice.Office">
    <node oor:name="ExtensionSecurity">
      <prop oor:name="DisableExtensionInstallation" oor:finalized="true" oor:type="xs:boolean"><value>true</value></prop>
    </node>
  </oor:component-data>
</oor:data>
