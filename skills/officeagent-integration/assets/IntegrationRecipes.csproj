<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OfficeAgentPackageVersion Condition="'$(OfficeAgentPackageVersion)' == ''">1.3.0</OfficeAgentPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OfficeAgent.Core" Version="$(OfficeAgentPackageVersion)" />
    <PackageReference Include="OfficeAgent.Word" Version="$(OfficeAgentPackageVersion)" />
  </ItemGroup>
</Project>
