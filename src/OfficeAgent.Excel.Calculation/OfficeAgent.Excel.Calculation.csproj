<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <Description>Optional Excel formula calculation for OfficeAgent.NET: after an edit, calculates a verified set of functions with ClosedXML and writes the results into the workbook's cached values, reporting every formula it cannot calculate rather than guessing.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OfficeAgent.Abstractions\OfficeAgent.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The allowlist is verified against this ClosedXML line; a minor update can change how a
         function evaluates, so it moves only with the tests. -->
    <PackageReference Include="ClosedXML" Version="[0.105.1, 0.106.0)" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
  </ItemGroup>
</Project>
