<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <Description>Contracts for OfficeAgent.NET, which lets AI agents and .NET applications edit existing Word, PowerPoint and Excel files and fill templates, built on the Open XML SDK: document handles, anchors, typed edit plans, change reports and capability labels. Most applications install OfficeAgent.Core and a format module rather than this package directly.</Description>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
  </ItemGroup>

</Project>
