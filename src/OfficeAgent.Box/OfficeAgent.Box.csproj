<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <Description>Box document provider for OfficeAgent.NET, which lets AI agents edit existing Word, PowerPoint and Excel files and fill templates: creates, registers, opens, and saves Word, PowerPoint, and Excel files stored in Box through the Box REST API, with ETag-conditional uploads that keep every earlier version in Box's history. Agents address documents by an opaque (connectionId, documentId); the provider never exposes Box file ids, folder ids, or credentials to the model.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OfficeAgent.Abstractions\OfficeAgent.Abstractions.csproj" />
    <ProjectReference Include="..\OfficeAgent.Core\OfficeAgent.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
  </ItemGroup>

</Project>
