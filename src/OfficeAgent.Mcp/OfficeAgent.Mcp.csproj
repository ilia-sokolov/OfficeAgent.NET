<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net8.0 keeps the dotnet tool working where only .NET 8 is installed; net10.0 is what the
         container and the self-contained downloads run, so they ship a supported runtime. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RollForward>LatestMajor</RollForward>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>officeagent-mcp</ToolCommandName>
    <Description>Model Context Protocol (MCP) server for OfficeAgent.NET: inspect and edit Word documents, PowerPoint decks, and Excel workbooks through structured plans over stdio or HTTP, with filesystem, SharePoint, session, and inline-content workflows.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OfficeAgent.Abstractions\OfficeAgent.Abstractions.csproj" />
    <ProjectReference Include="..\OfficeAgent.Core\OfficeAgent.Core.csproj" />
    <ProjectReference Include="..\OfficeAgent.Word\OfficeAgent.Word.csproj" />
    <ProjectReference Include="..\OfficeAgent.AgentFramework\OfficeAgent.AgentFramework.csproj" />
    <ProjectReference Include="..\OfficeAgent.SharePoint\OfficeAgent.SharePoint.csproj" />
    <ProjectReference Include="..\OfficeAgent.PowerPoint\OfficeAgent.PowerPoint.csproj" />
    <ProjectReference Include="..\OfficeAgent.Excel\OfficeAgent.Excel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.6.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" Pack="false" />
  </ItemGroup>

</Project>
