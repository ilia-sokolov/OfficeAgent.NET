<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- .NET 10 only: .NET 8 left support on 2026-11-10. The dotnet tool rolls forward to any
         newer major; the container and the self-contained downloads ship the .NET 10 runtime. -->
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <PackAsTool>true</PackAsTool>
    <PackageType>McpServer</PackageType>
    <ToolCommandName>officeagent-mcp</ToolCommandName>
    <Description>MCP server that lets Claude, Codex, Cursor, Copilot Studio and other AI agents edit existing Word, PowerPoint and Excel files and fill company templates without breaking their formatting. The agent previews a typed plan, nothing is written when a check fails, and Word edits can be saved as real tracked changes. Works over stdio or HTTP with local folders, SharePoint, iManage Work, Google Drive, Box, Azure Blob Storage and Amazon S3.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OfficeAgent.Abstractions\OfficeAgent.Abstractions.csproj" />
    <ProjectReference Include="..\OfficeAgent.Core\OfficeAgent.Core.csproj" />
    <ProjectReference Include="..\OfficeAgent.Word\OfficeAgent.Word.csproj" />
    <ProjectReference Include="..\OfficeAgent.AgentFramework\OfficeAgent.AgentFramework.csproj" />
    <ProjectReference Include="..\OfficeAgent.SharePoint\OfficeAgent.SharePoint.csproj" />
    <ProjectReference Include="..\OfficeAgent.IManage\OfficeAgent.IManage.csproj" />
    <ProjectReference Include="..\OfficeAgent.GoogleDrive\OfficeAgent.GoogleDrive.csproj" />
    <ProjectReference Include="..\OfficeAgent.Box\OfficeAgent.Box.csproj" />
    <ProjectReference Include="..\OfficeAgent.AzureBlob\OfficeAgent.AzureBlob.csproj" />
    <ProjectReference Include="..\OfficeAgent.AmazonS3\OfficeAgent.AmazonS3.csproj" />
    <ProjectReference Include="..\OfficeAgent.PowerPoint\OfficeAgent.PowerPoint.csproj" />
    <ProjectReference Include="..\OfficeAgent.Excel\OfficeAgent.Excel.csproj" />
    <ProjectReference Include="..\OfficeAgent.Excel.Calculation\OfficeAgent.Excel.Calculation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.1.0" />
    <PackageReference Include="ExcelNumberFormat" Version="1.2.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.2" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.11.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" Pack="false" />
    <!-- NuGet.org builds the MCP tab of the package page from this file. -->
    <None Include="..\..\server.json" Pack="true" PackagePath=".mcp\server.json" Visible="false" />
  </ItemGroup>

</Project>
