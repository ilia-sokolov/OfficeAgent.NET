<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <Description>Microsoft.Extensions.AI and Microsoft Agent Framework tools for OfficeAgent.NET: give an AI agent tools to inspect, find, preview and apply edits to existing Word, PowerPoint and Excel files and fill templates, as AIFunctions with structured JSON results. Also usable from Semantic Kernel.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OfficeAgent.Abstractions\OfficeAgent.Abstractions.csproj" />
    <ProjectReference Include="..\OfficeAgent.Core\OfficeAgent.Core.csproj" />
    <ProjectReference Include="..\OfficeAgent.Word\OfficeAgent.Word.csproj" />
    <ProjectReference Include="..\OfficeAgent.PowerPoint\OfficeAgent.PowerPoint.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the wire-contract baseline read the canonical plan serializer options. -->
    <InternalsVisibleTo Include="OfficeAgent.ApiDocs" />
    <InternalsVisibleTo Include="OfficeAgent.Tests" />
  </ItemGroup>

</Project>
