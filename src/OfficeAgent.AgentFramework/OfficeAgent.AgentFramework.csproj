<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <Description>Microsoft.Extensions.AI tool adapter for OfficeAgent.NET: projects Word, PowerPoint, and Excel inspect, find, preview, and apply workflows as AIFunctions with structured JSON results.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OfficeAgent.Abstractions\OfficeAgent.Abstractions.csproj" />
    <ProjectReference Include="..\OfficeAgent.Core\OfficeAgent.Core.csproj" />
    <ProjectReference Include="..\OfficeAgent.Word\OfficeAgent.Word.csproj" />
    <ProjectReference Include="..\OfficeAgent.PowerPoint\OfficeAgent.PowerPoint.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.6.0" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the wire-contract baseline read the canonical plan serializer options. -->
    <InternalsVisibleTo Include="OfficeAgent.ApiDocs" />
  </ItemGroup>

</Project>
